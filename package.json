{
  "name": "workeasy",
  "version": "1.2.0",
  "description": "1-Click Workspace and App Template Launcher for Developers",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sharief2854/workEasy.git"
  },
  "scripts": {
    "dev": "concurrently -k \"cross-env VITE_DEV_SERVER=true vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER=true electron .\"",
    "start": "electron .",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder",
    "build:publish": "vite build && electron-builder --publish always",
    "preview": "vite preview"
  },
  "keywords": [
    "workspace",
    "launcher",
    "productivity",
    "electron",
    "react"
  ],
  "author": "Sharief",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.workeasy.app",
    "productName": "WorkEasy",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "icon": "public/workeasy.ico",
      "target": [
        "nsis",
        "portable",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "WorkEasy",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sharief2854",
        "repo": "workEasy"
      }
    ]
  }
}
